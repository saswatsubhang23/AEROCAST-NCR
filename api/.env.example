# Copy to api/.env and fill in. api/.env is git-ignored. Never put real secrets in this file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL/PostGIS (local or remote). Local setup: api/scripts/setup_local_postgres.sql, then `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://aerocast:CHANGE_ME@<postgres-host>:5432/aerocast
DATABASE_CONNECT_TIMEOUT_S=2

# Ollama (separate machine)
OLLAMA_BASE_URL=http://<ollama-host>:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_S=3
# Assistant tuning (see docs/assistant.md). Raise LLM_TIMEOUT_S on slow, CPU-only hosts.
# LLM_TIMEOUT_S=180
# LLM_MAX_TOKENS=800
# LLM_NUM_CTX=8192
# LLM_THINK=false

# Data providers (leave blank until provided)
# Weather: Open-Meteo (no key). Defaults are fine; override only to point at a mirror.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive   # historical pipeline only (docs/historical-data-pipeline.md)
# WEATHER_CACHE_TTL_S=900
# OPEN_METEO_API_KEY=                                        # optional commercial key for higher rate limits
# Air quality: OpenAQ v3 (free key: https://explore.openaq.org/register). See docs/air-quality-source.md
AQ_API_KEY=
# AQ_API_BASE_URL=https://api.openaq.org/v3
# AQ_REFERENCE_ONLY=true
# AQ_PROVIDER_IDS=
# INDIA_AQI_API_KEY=                                         # historical CPCB archive key from xKDR (offline training only)

# Knowledge base (see docs/knowledge-base.md); all optional
# KB_DIR=./data/kb
# KB_MAX_UPLOAD_MB=10
# KB_MIN_SCORE=0.62

# Reports and alerts store their data under DATA_DIR (alert rules in alerts.sqlite). Reports themselves are held in memory.
# DATA_DIR=./data

# Optional external pollution-forecasting service (interface only; see docs/ml-forecast-interface.md).
# Leave ML_FORECAST_URL empty and forecasts are simply reported as unavailable.
# ML_FORECAST_URL=
# ML_FORECAST_API_KEY=
# ML_FORECAST_TIMEOUT_S=30

# Optional LOCAL model trained offline with `python -m app.ml train` (docs/ml-training-pipeline.md). Used only when ML_FORECAST_URL is empty.
# ML_LOCAL_MODEL_DIR=./data/models
# ML_HISTORY_DB=./data/history.sqlite
# ML_MAX_STATION_KM=15
# ML_MAX_INPUT_AGE_HOURS=6

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional Jev (TypeSafe) decision support, shadow only (docs/jev-integration.md). Default: off.
# JEV_MODE=off
# TYPESAFE_API_KEY=
# JEV_MODEL=
